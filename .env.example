# --- Frontend (Vite) ---
# Base URL del backend. En producción con backend + SPA en el mismo servicio Railway,
# dejar en "/api" para usar rutas relativas. Para desarrollo local queda cubierto
# por el proxy de Vite (ver vite.config.ts).
VITE_API_URL=/api

# --- Backend (Express) ---
# Conexión a PostgreSQL. En Railway se inyecta automáticamente por el plugin.
DATABASE_URL=postgres://user:password@host:5432/dbname

# Secret para firmar JWTs de sesión. Usar algo largo y aleatorio.
JWT_SECRET=replace-me-with-a-long-random-string

# Expiración del JWT (formato de ms/zeit — ej. "7d", "12h").
JWT_EXPIRES_IN=7d

# Puerto — Railway lo inyecta como PORT. En local se puede dejar en 3000.
PORT=3000

# "production" activa el servido de archivos estáticos desde dist/.
NODE_ENV=development

# Orígenes permitidos por CORS (coma-separado). Vacío = permite todo (dev).
# En prod: https://beast-hub-command.up.railway.app (o el dominio real).
CORS_ORIGIN=

# --- Admin seed (quemado por defecto) ---
# El server inserta un admin automáticamente en el primer arranque.
# Defaults si no se setean: admin@beasthub.com / admin123 (cambiar tras primer login).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# --- Importación automática de pedidos Shopify desde Gmail (opcional) ---
# OAuth "App de escritorio" de Google Cloud con Gmail API habilitada (scope gmail.readonly).
# El refresh token se obtiene una vez con: node scripts/gmail-auth.mjs
# Sin estas tres variables el sondeo queda desactivado. Nunca ponerlas en .env (versionado).
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Minutos entre revisiones del buzón (default 5).
GMAIL_POLL_MINUTES=
