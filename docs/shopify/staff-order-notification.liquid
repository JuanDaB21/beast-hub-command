{%- comment -%}
  BEAST HUB — bloque de importación automática de pedidos (v1)

  Dónde: Shopify Admin → Configuración → Notificaciones → Notificaciones al
  personal → "Nuevo pedido" → Editar código. Pegar TODO este bloque al final del
  HTML, justo antes de </body> (o al final si no hay </body>). No cambia lo que
  se ve en el correo: va dentro de un div oculto.

  Qué hace: imprime el pedido completo (cliente, dirección, teléfono, líneas con
  SKU/variant_id y pasarela de pago) como JSON en base64 entre los marcadores
  BEASTHUB_ORDER_JSON_START / BEASTHUB_ORDER_JSON_END. El servidor lo lee de
  Gmail (server/lib/orderEmailIngest.ts → extractOrderPayload) y lo importa con
  syncOrders(), igual que el CSV.

  Precios: Liquid los da en centavos → se dividen entre 100.
  Si "base64_encode" no estuviera disponible, quitar ese filtro: el servidor
  acepta también el JSON plano entre los marcadores.
{%- endcomment -%}
{%- capture beasthub_json -%}
{
  "v": 1,
  "id": {{ id | json }},
  "name": {{ name | json }},
  "created_at": {{ created_at | date: "%Y-%m-%dT%H:%M:%S%z" | json }},
  "financial_status": {{ financial_status | json }},
  "fulfillment_status": {{ fulfillment_status | json }},
  {%- assign beasthub_pg = transactions.first.gateway_display_name | default: transactions.first.gateway | default: gateway -%}
  "payment_gateway": {{ beasthub_pg | json }},
  "total_price": "{{ total_price | divided_by: 100.0 }}",
  "shipping_price": "{{ shipping_price | divided_by: 100.0 }}",
  "customer": {
    "first_name": {{ customer.first_name | json }},
    "last_name": {{ customer.last_name | json }},
    "phone": {{ customer.phone | json }},
    "email": {{ customer.email | default: email | json }}
  },
  "shipping_address": {
    "name": {{ shipping_address.name | json }},
    "phone": {{ shipping_address.phone | json }},
    "address1": {{ shipping_address.address1 | json }},
    "address2": {{ shipping_address.address2 | json }},
    "city": {{ shipping_address.city | json }}
  },
  "billing_address": {
    "name": {{ billing_address.name | json }},
    "phone": {{ billing_address.phone | json }},
    "address1": {{ billing_address.address1 | json }},
    "address2": {{ billing_address.address2 | json }},
    "city": {{ billing_address.city | json }}
  },
  "line_items": [
    {%- for line in line_items -%}
    {%- assign beasthub_price = line.original_price | default: line.price -%}
    {
      "variant_id": {{ line.variant_id | json }},
      "sku": {{ line.sku | json }},
      "title": {{ line.title | json }},
      "quantity": {{ line.quantity | json }},
      "price": "{{ beasthub_price | divided_by: 100.0 }}"
    }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
}
{%- endcapture -%}
<div style="display:none;font-size:0;line-height:0;max-height:0;overflow:hidden;mso-hide:all">BEASTHUB_ORDER_JSON_START{{ beasthub_json | base64_encode }}BEASTHUB_ORDER_JSON_END</div>
